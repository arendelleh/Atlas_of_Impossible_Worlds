{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Atlas",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/run.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Rebuild Atlas",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/build-local.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    }
  ]
}
